@page
@model ShoppeWeb.Pages.Customer.CartModel
@{
}

<div class="container my-5">
    <h2 class="mb-4 text-center">🛒 Shopping Cart</h2>

    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>

                            <!-- Product 1 -->
                            @foreach (var item in Model.ShoppingCartList)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.MenuItem.Image"
                                                 class="img-thumbnail me-3"
                                                 width="80" height="80" alt="Product">
                                            <div>
                                                <h6 class="mb-1">@item.MenuItem.Name</h6>
                                                <small class="text-muted">Category: @item.MenuItem.Category.Name</small><br>
                                                <small class="text-muted">Type: @item.MenuItem.FoodType.Type</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>₹@item.MenuItem.Price</td>
                                    <td>
                                        <input type="number" class="form-control" value="@item.Count" min="1" style="width:80px;">
                                    </td>
                                    <td>₹2,000</td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- Summary Section -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>₹@Model.CartTotal</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (18%)</span>
                        <span>₹648</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span>₹100</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Grand Total</span>
                        <span>₹4,348</span>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-success btn-lg">
                            Proceed to Checkout
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

