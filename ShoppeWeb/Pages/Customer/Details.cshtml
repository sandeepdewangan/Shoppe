@page
@model ShoppeWeb.Pages.Customer.DetailsModel

<div class="container mt-5">
    <div class="row">
        <form method="post">
            <input asp-for="ShoppingCart.ApplicationUserId" hidden />
            <input asp-for="ShoppingCart.MenuItemId" hidden />
            <!-- Product Image -->
            <div class="col-md-5">
                <img src="@Model.ShoppingCart.MenuItem.Image"
                     class="img-fluid rounded shadow-sm"
                     style="max-height:400px; object-fit:cover;" />
            </div>

            <!-- Product Info -->
            <div class="col-md-7">
                <h2 class="mb-3">@Model.ShoppingCart.MenuItem.Name</h2>

                <!-- Category Chip -->
                <span class="badge rounded-pill bg-info text-dark mb-2">
                    @Model.ShoppingCart.MenuItem.Category.Name
                </span>

                <!-- Food Type -->
                <p class="mt-3 mb-1">
                    <strong>Food Type:</strong> @Model.ShoppingCart.MenuItem.FoodType.Type
                </p>

                <!-- Price -->
                <h4 class="text-success mt-3">
                    $@Model.ShoppingCart.MenuItem.Price
                </h4>

                <hr />

                <!-- Description -->
                <p class="text-muted">
                    @Html.Raw(Model.ShoppingCart.MenuItem.Description)
                </p>
                <label asp-for="ShoppingCart.Count"></label>
                <input asp-for="ShoppingCart.Count" />
                <span asp-validation-for="ShoppingCart.Count" class="text-danger"></span>


                <!-- Actions -->
                <div class="d-flex gap-3 mt-4">

                    <!-- Add to Cart -->
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-cart-plus"></i>
                        Add to Cart
                    </button>

                    <!-- Go Back -->
                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        ← Go Back
                    </a>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}