@page
@model ShoppeWeb.Pages.Customer.IndexModel

<div class="container mt-4">
    <div class="row">

        @foreach(var cat in Model.CategoryList)
        {
            <div class="h2">
                @cat.Name
            </div>
            @foreach (var item in @Model.MenuItemList.Where(i=>i.CategoryId == cat.id))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <img src="@item.Image"
                         class="card-img-top"
                         alt="@item.Name"
                         style="height:200px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">
                            <a asp-page="Details" asp-route-id=@item.Id> <h5 class="card-title">@item.Name</h5></a>

                        <p class="card-text text-muted">
                                @Html.Raw(item.Description)
                        </p>

                        <p class="mb-1">
                            <strong>Food Type:</strong> @item.FoodType.Type

                        </p>

                        <p class="mb-2">
                            <strong>Category:</strong> @item.Category.Name
                        </p>

                        <div class="mt-auto">
                            <h5 class="text-success">$@item.Price</h5>
                        </div>
                    </div>
                </div>
            </div>
        }
        }
        
        
    </div>
</div>
