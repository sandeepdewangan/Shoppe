@page
@model ShoppeWeb.Pages.Admin.MenuItems.CreateModel



<div>
    <form method="post" enctype="multipart/form-data">
        <h1 class="text-lg">@(Model.MenuItem.Id != 0 ? "Update": "Insert") Menu Item</h1>
        <div>
            <label asp-for="MenuItem.Name">Menu Item Name</label>
            <input asp-for="MenuItem.Name" />
            <span asp-validation-for="MenuItem.Name" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="MenuItem.Description">Description</label>
            <textarea asp-for="MenuItem.Description"></textarea>
            <span asp-validation-for="MenuItem.Description" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="MenuItem.Price">Price</label>
            <input asp-for="MenuItem.Price" />
            <span asp-validation-for="MenuItem.Price" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="MenuItem.Image">Image</label>
            <input type="file" name="productImage" id="productImage" />
        </div>
        <div>
            <label asp-for="MenuItem.FoodTypeId">Food Type</label>
            <select asp-for="MenuItem.FoodTypeId" asp-items="Model.FoodTypeList">
                <option disabled selected>Select Food Type</option>
            </select>
            <span asp-validation-for="MenuItem.FoodTypeId" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="MenuItem.CategoryId">Category</label>
            <select asp-for="MenuItem.CategoryId" asp-items="Model.CategoryList">
                <option disabled selected>Select Category</option>
            <</select>
            <span asp-validation-for="MenuItem.CategoryId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create Menu Item</button>
    </form>
</div>

@section Scripts {
    <!-- Place the following <script> and <textarea> tags your HTML's <body> -->
